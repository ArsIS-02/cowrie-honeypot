[Unit]
Description=Cowrie SSH/Telnet honeypot
After=network-online.target

[Container]
Image=docker.io/cowrie/cowrie:latest
ContainerName=cowrie
PublishPort=2222:2222
PublishPort=2223:2223
Volume=%h/cowrie/data:/cowrie/cowrie-git/var:z
Volume=%h/cowrie/etc/cowrie.cfg:/cowrie/cowrie-git/etc/cowrie.cfg:z
Volume=%h/cowrie/etc/userdb.txt:/cowrie/cowrie-git/etc/userdb.txt:z

[Service]
Restart=always
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=default.target
